NODE_ENV=development
APP_NAME="ProgresIA Studio"

# ──────────────────────────────────────────────────────────────────────────────
# ROOT .env — Docker Compose + referencia global.
#
# Para desarrollo local, cada servicio usa su propio .env:
#   apps/api/.env         → NestJS  (DB, JWT, admin secrets, MinIO, Redis)
#   apps/ai-service/.env  → FastAPI (LLM API keys y modelos)
#   apps/web/.env         → Vite    (VITE_* públicas)
#
# Las LLM API keys van SOLO en apps/ai-service/.env.
# Docker Compose las carga desde ahí automáticamente.
# ──────────────────────────────────────────────────────────────────────────────

# Frontend — build args para Docker y fallback sin apps/web/.env
VITE_API_URL=http://localhost:3000/api
VITE_AI_SERVICE_URL=http://localhost:8003
VITE_CAPTCHA_PROVIDER=turnstile
VITE_CAPTCHA_SITE_KEY=

# API
API_PORT=3000
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1d
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=

# Base de datos
POSTGRES_USER=progresia
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=progresia_studio
DATABASE_URL=postgresql://progresia:change_me_in_production@127.0.0.1:5432/progresia_studio

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PUBLIC_PORT=6380

# MinIO
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=progresia
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=progresia-artifacts

# AI service — puerto e URL (LLM keys en apps/ai-service/.env)
AI_SERVICE_PORT=8003
AI_SERVICE_URL=http://127.0.0.1:8003
QDRANT_URL=http://localhost:6333

# Email (Mailpit en local: smtp://localhost:1025)
EMAIL_FROM="ProgresIA Studio <no-reply@progresia.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Integraciones opcionales
GITHUB_TOKEN=
SENTRY_DSN=
