# General
NODE_ENV=development
APP_NAME="ProgresIA Studio"

# Frontend
VITE_API_URL=http://localhost:3000/api
VITE_AI_SERVICE_URL=http://localhost:8000

# Backend
API_PORT=3000
POSTGRES_USER=progresia
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=progresia_studio
DATABASE_URL=postgresql://progresia:change_me_in_production@localhost:5432/progresia_studio
JWT_SECRET=change_me
JWT_EXPIRES_IN=1d
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PUBLIC_PORT=6380
SENTRY_DSN=

# IA Service
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://127.0.0.1:8000

# LLM provider default (groq | openai | gemini | ollama)
# Each agent auto-routes: reasoning→Groq, spec→OpenAI, code→Ollama qwen2.5-coder
LLM_PROVIDER=groq

# Groq — fast inference, reasoning and requirements agents
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI — complex structured spec generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini — fallback for spec / general
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama — local, no key needed; llama3.1 for reasoning, qwen2.5-coder for code gen
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING_MODEL=llama3.1
OLLAMA_CODE_MODEL=qwen2.5-coder

QDRANT_URL=http://localhost:6333

# Storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=progresia
MINIO_SECRET_KEY=progresia_secret
MINIO_BUCKET=progresia-artifacts

# GitHub integration (optional — required for push-to-github feature)
GITHUB_TOKEN=
