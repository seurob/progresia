{
  "name": "progresia-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma multiagente para transformar ideas de negocio en MVPs software desplegables.",
  "workspaces": [
    "apps/web",
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run start:dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "openspec:check": "node scripts/validate-openspec.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "js-yaml": "4.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
