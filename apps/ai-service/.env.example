APP_NAME="ProgresIA Studio AI Service"
AI_SERVICE_PORT=8003

# LLM provider default (groq | openai | gemini | ollama)
LLM_PROVIDER=groq

# Groq - fast inference, reasoning and requirements agents
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI - complex structured spec generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini - fallback for spec/general
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Ollama - local, no key needed
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_REASONING_MODEL=llama3.1
OLLAMA_CODE_MODEL=qwen2.5-coder

QDRANT_URL=http://localhost:6333

# Sentry (optional)
AI_SENTRY_DSN=
AI_SENTRY_ENVIRONMENT=development
AI_SENTRY_RELEASE=
AI_SENTRY_TRACES_SAMPLE_RATE=0.1
AI_SENTRY_ENABLE_LOGS=false
