NODE_ENV=development
API_PORT=3000

# Base de datos
DATABASE_URL=postgresql://progresia:change_me@127.0.0.1:5432/progresia_studio

# JWT
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1d

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380

# AI service
AI_SERVICE_URL=http://127.0.0.1:8003

# MinIO (object storage para ZIPs)
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=progresia
MINIO_SECRET_KEY=change_me_in_production
MINIO_BUCKET=progresia-artifacts

# CORS
CORS_ORIGINS=http://localhost:5173

# CAPTCHA — Cloudflare Turnstile test keys (always pass, safe for dev)
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SECRET_KEY=

# Panel admin — cambiar SIEMPRE antes de desplegar a producción
ADMIN_JWT_SECRET=change_me_in_production
ADMIN_EMAIL=admin@progresia.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production
